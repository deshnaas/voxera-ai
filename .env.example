# ============================================================
# VOXERA — environment configuration
# Copy to .env and fill in.  .env is git-ignored.
# ============================================================

# --- Supabase (required for persistence / dashboard) --------
# Use the NEW project's URL and its SERVICE-ROLE key (server-side only -
# never ship this to a browser/frontend). .env is git-ignored.
SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-NEW-SERVICE-ROLE-KEY
# (legacy fallbacks still read if present: SUPABASE_KEY, SUPABASE_ANON_KEY)

# --- Audio devices -----------------------------------------
# Run:  python -c "import sounddevice as sd; print(sd.query_devices())"
VOXERA_MIC_DEVICE=1
# VOXERA_OUTPUT_DEVICE=            # blank = system default

# --- Models -----------------------------------------------
VOXERA_WHISPER_MODEL=base.en       # base.en (fast) | small.en (more accurate, ~2.5s)
VOXERA_LLM_MODEL=qwen3:1.7b        # must be pulled in Ollama
VOXERA_OLLAMA_URL=http://localhost:11434/api/chat
VOXERA_LLM_MAX_TOKENS=64
VOXERA_LLM_KEEP_ALIVE=30m

# --- Voice / TTS ------------------------------------------
VOXERA_TTS_SPEED=1.08

# --- Turn-taking / VAD (endpointing) --------------------
VOXERA_END_SILENCE=0.80            # silence after speech before a turn ends (~0.6-1.0)
VOXERA_ENDPOINT_RATIO=0.32         # a drop below this fraction of the speaking level = silence
VOXERA_ENDPOINT_NOISE_MULT=2.2     # ...or back down to this multiple of the idle noise floor
VOXERA_MAX_TURN=20                 # hard cap on one patient turn (noisy-room safety net)
# VOXERA_START_THRESHOLD=          # force values from mic_check.py in a noisy room
# VOXERA_END_THRESHOLD=
# VOXERA_DEBUG_VAD=1               # print endpoint decisions per turn

# --- Barge-in --------------------------------------------
# aec = true-duplex barge-in via WebRTC AEC + strict multi-signal gate (default)
# off = strict turn-taking (Priya always finishes, then a listening window)
VOXERA_BARGEIN=aec

# --- Structured facts in the prompt ---------------------
# 0 = track/persist facts but don't inject into the prompt (qwen3:1.7b does
#     better on raw history). 1 = inject the compact state (use with a bigger model).
VOXERA_INJECT_FACTS=0

# --- Demo identity (local mic stands in for the phone caller) --
VOXERA_DEMO_PATIENT_NAME=Voxera Demo Patient
VOXERA_DEMO_PHONE=9990001111
VOXERA_DEMO_LANGUAGE=English
VOXERA_GREETING=Hi, this is Voxera from City Hospital. How can I help you today?

# --- Patient Intelligence (voxera_patientfetch) ---------------------
# 1 = patient-ID verification + record Q&A + adaptive triage on calls (needs sql/2026_voxera_patient_intelligence.sql).
# 0 = classic call flow. If the migration has not been run the layer switches itself off.
VOXERA_PATIENTFETCH=1
# Voice signal (SpeechBrain model in an isolated venv). 0 disables it. Conversational hint only, never an alert.
VOXERA_VOICE_SIGNAL=1
# VOXERA_VOICE_PY=path	o\other\python.exe   (default: voxera_patientfetch/.venv_voice)
# VOXERA_VOICE_WINDOW=4.0   (seconds of audio sent to the model; lower = faster)
# Optional local reword of record answers (3-5 s on CPU, so OFF by default). Output is validated and discarded if it changes a fact.
VOXERA_RECORD_LLM=0
# VOXERA_RECORD_MODEL=voxera-patientfetch
# Prewarm the ID/triage phrases in TTS at boot (slower start, instant replies). 0 to skip.
VOXERA_PREWARM_PF=1
# Patient-records API (uvicorn voxera_patientfetch.service:app --port 8100)
# VOXERA_API_ORIGINS=http://localhost:3000
# Legacy hospital_users.role='staff' is treated as this role (default doctor, so existing demo logins keep working).
# VOXERA_LEGACY_STAFF_ROLE=doctor

# --- Multilingual voice (voxera_multilang) ----------------------------
# Detect the caller's language (English / Hindi / Marathi) and reply in it. 0 = English only.
# Needs the model built once:  python -m voxera_multilang.build_fast_stt
VOXERA_MULTILANG=1
# VOXERA_MULTI_STT_DIR=path\to\other\ct2-whisper-model   (default: voxera_multilang/.model_cache/whisper-small-int8)

# --- Phone line (Exotel) ---
# Secret Exotel must present (as ?token=... or the Basic-auth password). SET THIS before exposing the server.
VOXERA_STREAM_TOKEN=
VOXERA_PHONE_PORT=8200
